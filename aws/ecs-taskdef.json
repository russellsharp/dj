{
    "family": "aspnetcore-net11-app",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "operatingSystemFamily": "LINUX",
        "cpuArchitecture": "X86_64"
    },
    "executionRoleArn": "arn:aws:iam::648807276746:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::648807276746:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "dotnet11-api",
            "image": "648807276746.dkr.ecr.us-east-1.amazonaws.com/dj/api-repo:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:80/api/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "secrets": [
                {
                    "name": "DJ_SECURITY_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:648807276746:secret:dev/dj/scopedSecret-nqJtd7:DJ_SECURITY_KEY::"
                },
                {
                    "name": "DJ_TMDB_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:648807276746:secret:dev/dj/tmdbApiKey-8d5jtQ:DJ_TMDB_API_KEY::"
                }
            ],
            "environment": [
                {
                    "name": "ASPNETCORE_ENVIRONMENT",
                    "value": "Production"
                },
                {
                    "name": "ASPNETCORE_HTTP_PORTS",
                    "value": "80"
                },
                {
                    "name": "ASPNETCORE_URLS",
                    "value": "http://+:80"
                },
                {
                    "name": "DJ_MEDIA_BASE_DIRECTORY",
                    "value": "//fatty/Existing/"
                },
                {
                    "name": "DJ_MEDIA_DATABASE_PATH",
                    "value": "data/media.db"
                },
                {
                    "name": "TMDB:DatabasePath",
                    "value": "data/tmdb.db"
                },
                {
                    "name": "DJ_HOST_ALLOWED_CORS_URL",
                    "value": "127.0.0.1,127.0.0.1"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/aspnetcore-net11-app",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "web",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}