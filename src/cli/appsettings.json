{
    "MediaReaderConfiguration": {
        "BaseDirectory": "//fatty/Existing/",
        "Filter": "*.*",
        "DirectoryRecursionDepth": 50,
        "MovieExtensions": ".+\\.avi$;.+\\.mp4$;.+\\.mkv$;.+\\.wmv$;.+\\.mpg$;",
        "AudioExtensions": ".+\\.mp3$;.+\\.m4a$;.+\\.aac$;"
    },
    "MediaDatabaseConfiguration": {
        "DataFile": "testdatabase/media.db"
    },
    "TMDB": {
        "BaseUrl": "https://api.themoviedb.org/3",
        "DatabasePath": "testdata/tmdb.db",
        "RequestLimit": 10,
        "RequestWindow": 10,
        "AttemptCountMax": 10,
        "BackOffTimeMs": 1000
    }
}