# @withCredentials false
# @no-cookie
# @no-log
# @no-reject-unauthorized // <--- ADD THIS LINE TO THE TOP OF YOUR FILE

# Disable SSL certificate strictness for local dev certificates
@settings = {"request.certificates.strictSSL": false}

# Corrected port variables based on your console logs
@api_HostAddressSecure = https://localhost:7123/api
@api_HostAddress = http://127.0.0.1:5282/api

GET {{api_HostAddress}}/health
Accept: application/json
###

Get https://localhost:7123/openapi/v1.json
Accept: application/json
###

# @name readToken
GET {{api_HostAddress}}/token/anonymous
Accept: application/json
###

@token = {{readToken.response.body.access_token}}

###

# @name readToken
POST {{api_HostAddressSecure}}/token/scoped
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=console-app-client-read&client_secret=super-secret-password-123&scope=media:read

###
# @name writeToken
POST {{api_HostAddressSecure}}/token/scoped
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=console-app-client-rw&client_secret=super-secret-password-123&scope=media:write media:read

###
GET {{api_HostAddressSecure}}/media/search?query=training,day
Authorization: Bearer {{readToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/query?query=training,day
Authorization: Bearer {{readToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/details?query=training,day
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/media?type=Video&updateRepo=true
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/match/local?query=dirty,cop&type=Video&minimumHits=1
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/match/local/synonyms?query=dirty,cop&type=Video&minimumHits=1
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}

###

POST {{api_HostAddressSecure}}/media/update/?fromScratch=true&baseDirectory=//fatty/existing
Accept: application/json
Authorization: Bearer {{writeToken.response.body.access_token}}

###

GET {{api_HostAddressSecure}}/media/update/status/
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}
###

POST {{api_HostAddressSecure}}/media/update/cancel
Accept: application/json
Authorization: Bearer {{writeToken.response.body.access_token}}
###

POST {{api_HostAddressSecure}}/media/tmdb/update
Accept: application/json
Authorization: Bearer {{writeToken.response.body.access_token}}
###

POST {{api_HostAddressSecure}}/media/tmdb/update/cancel
Accept: application/json
Authorization: Bearer {{writeToken.response.body.access_token}}
###

GET {{api_HostAddressSecure}}/media/tmdb/update/status
Accept: application/json
Authorization: Bearer {{readToken.response.body.access_token}}
###