{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:80"
      }
    }
  },
  "AllowedHosts": "*",
  "MediaCollectionConfiguration": {
    "BaseDirectory": "//fatty/Existing/",
    "Filter": "*.*",
    "DirectoryRecursionDepth": 50,
    "VideoExtensions": "avi;mp4;mkv;wmv;mpg;",
    "AudioExtensions": "mp3;m4a;aac;"
  },
  "MediaDatabaseConfiguration": {
    "DataFile": "data/media.db"
  },
  "AuthUsers": {
    "DatabasePath": "data/testusers.db"
  },
  "OpenIdDict": {
    "DatabasePath": "data/openiddict.db"
  },
  "TMDB": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "DatabasePath": "data/tmdb.db"
  },
  "HostConfiguration": {
    "CorsAllowedUrl": [
      "127.0.0.1",
      "127.0.0.2"
    ],
    "RateLimiters": {
      "heavy": {
        "PermitLimit": 1,
        "WindowSeconds": 10,
        "QueueProcessingOrder": "OldestFirst",
        "QueueLimit": 1
      },
      "health": {
        "PermitLimit": 60,
        "WindowSeconds": 1,
        "QueueProcessingOrder": "OldestFirst",
        "QueueLimit": 60
      }
    },
    "AllowedHosts": "*",
    "Jwt": {
      "Key": "YOUR_SUPER_SECRET_KEY_THAT_IS_AT_LEAST_32_CHARACTERS_LONG",
      "Issuer": "https://localhost:5282",
      "Audience": "https://localhost:7132"
    }
  }
}